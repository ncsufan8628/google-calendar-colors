{
  "name": "google-calendar-colors-week-planner-card",
  "version": "1.0.1",
  "description": "A Google-event-color-aware, backward-compatible week-planner-card distribution.",
  "type": "module",
  "source": "src/index.js",
  "module": "dist/week-planner-card.js",
  "targets": {
    "module": {
      "includeNodeModules": true,
